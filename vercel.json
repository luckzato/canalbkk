{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"no dependencies needed\"",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/stations.js": {
      "maxDuration": 15
    },
    "api/rain.js": {
      "maxDuration": 15
    },
    "api/presence.js": {
      "maxDuration": 10
    },
    "api/stats.js": {
      "maxDuration": 10
    }
  }
}